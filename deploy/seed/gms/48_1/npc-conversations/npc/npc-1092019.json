              }
            ],
            "maxLength": 16,
            "minLength": 1,
            "nextState": "incorrect",
            "text": "One day, I went to the ocean and caught 62 Octopi for dinner. But then some kid came by and gave me 10 Octopi as a gift! How many Octopi do I have then, in total?"
          },
          "id": "askAnswer",
          "type": "askText"
