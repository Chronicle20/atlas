meta {
  name: Discard Parcel
  type: http
  seq: 4
}

patch {
  url: {{scheme}}://{{host}}:{{port}}/api/parcels/{{parcelId}}
  body: json
  auth: inherit
}

body:json {
  {
    "data":
      {
        "type": "parcels",
        "id": "{{parcelId}}",
        "attributes": {
          "recipientId": {{recipientId}}
        }
      }
  }
}
